# ==============================================================================
# Seovy - Laravel SEO Platform Yapılandırma Dosyası
# ==============================================================================

APP_NAME=Seovy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Kurulum Modu: self_hosted (Tekil Sunucu / Kendi Sunucun) veya saas (Çok Müşterili)
APP_INSTALL_MODE=self_hosted

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ==============================================================================
# Veritabanı (Üretim için PostgreSQL 16 önerilir, yerel geliştirme için sqlite/mysql)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=seovy
DB_USERNAME=seovy_user
DB_PASSWORD=secret

# ==============================================================================
# Oturum, Önbellek ve Kuyruk (Üretimde Redis zorunludur)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# E-Posta Yapılandırması (Bildirimler, davetler, şifre sıfırlama)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@seovy.local"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# Güvenli HTTP Tarayıcı (Crawler) Parametreleri & SSRF Koruması
# ==============================================================================
# Tarayıcı istek zaman aşımı (saniye)
CRAWLER_DEFAULT_TIMEOUT=15
# Sayfa başına maksimum yanıt boyutu (Byte, varsayılan 5 MB = 5242880)
CRAWLER_MAX_RESPONSE_BYTES=5242880
# Alan adı başına varsayılan eşzamanlı istek limiti
CRAWLER_CONCURRENCY=5
# Saniye başına maksimum istek hızı
CRAWLER_RATE_LIMIT=5
# Tarayıcı User-Agent başlığı
CRAWLER_USER_AGENT="SeovyBot/1.0 (+https://seovy.local/bot)"

# ==============================================================================
# Harici API & Entegrasyonlar (İsteğe bağlı - Yapılandırılmadığında lokal/csv kullanılır)
# ==============================================================================
# Google Search Console / Google Cloud OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"

# Google PageSpeed Insights API Key
PAGESPEED_API_KEY=

# SERP Sıra Takibi Sağlayıcı (isteğe bağlı: mock, dataforseo, serpapi)
SERP_PROVIDER=mock
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# İsteğe Bağlı AI İçerik Önerisi Sağlayıcı (openai / claude / gemini)
AI_PROVIDER=
AI_API_KEY=

# Stripe Test / Canlı Modu (SaaS abonelikleri için)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
